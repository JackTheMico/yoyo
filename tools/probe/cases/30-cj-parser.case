# 串击解析状态机（issue #53）
#
# 规则（见 rime/lua/yoyo/cj_parser.lua）：
#   2 码：不存在更长码          → 第 2 键立即上屏
#   3 码：不是任何 4 码词前缀    → 第 3 键立即上屏
#   4 码：存在 4 码词           → 第 4 键立即上屏
#   其余：等空格定界（空格按最长可解析前缀上屏）
#
# 为什么不是「3 码时比较 2 码单元与 3 码字权重」：实测该规则在连续输入下
# 正确率仅 25%（见 docs/design/cj-parsing-rules.md）。根因是 3500 个 2 码位里
# 有 3499 个都是更长码的前缀，「当前缓冲唯一可解」不代表首单元正确。

# ── 分支 1：2 码，不存在更长码 → 立即上屏 ─────────────────────────────────
# >g 是全表唯一一个无更长码的 2 码位。
case cj_二码无更长码_第2键立即上屏_鬲
schema yoyo-pure-cj
step >      ""    ">"
step g      "鬲"  ""

# ── 分支 2：2 码，有更长码（slg / sl:N）→ 等待，空格定界 ─────────────────
case cj_二码有更长码_等空格_了
schema yoyo-pure-cj
step s      ""    "s"
step l      ""    "sl"
step space  "了"  ""

# ── 分支 3：4 码词，第 4 键自动上屏 ──────────────────────────────────────
# ,,T 是 3 码字「琶」，同时是 4 码词「璀璨夺目」的前缀。
case cj_四码词_第4键自动上屏_璀璨夺目
schema yoyo-pure-cj
step ,      ""    ","
step ,      ""    ",,"
step T      ""    ",,T"
step T      "璀璨夺目"  ""

# ── 分支 4：同前缀按空格取 3 码字（覆盖分支 3 的等待语义）────────────────
case cj_三码是四码词前缀_空格出_琶
schema yoyo-pure-cj
step ,      ""    ","
step ,      ""    ",,"
step T      ""    ",,T"
step space  "琶"  ""

# ── 分支 5：3 码，非 4 码词前缀 → 第 3 键立即上屏 ────────────────────────
case cj_三码非前缀_第3键立即上屏_珏
schema yoyo-pure-cj
step ,      ""    ","
step ,      ""    ",,"
step O      "珏"  ""

# ── 分支 6：死缓冲 → 整段作废，不进拼写缓冲 ──────────────────────────────
# lk 既不是 2 码单元，也不是任何 3/4 码的前缀（全表共 32 个这类组合）。
case cj_死缓冲_整段作废无残留
schema yoyo-pure-cj
step l      ""    "l"
step k      ""    ""

# ── 分支 7：退格清空整个码元缓冲（一次退格 = 撤一个单元）─────────────────
case cj_退格_清空整个缓冲
schema yoyo-pure-cj
step s      ""    "s"
step l      ""    "sl"
step bs     ""    ""

# ── 分支 8：Esc 清空，不上屏 ────────────────────────────────────────────
case cj_Esc_清空不上屏
schema yoyo-pure-cj
step s      ""    "s"
step l      ""    "sl"
step esc    ""    ""

# ── 分支 9：上屏后连续输入不串码 ─────────────────────────────────────────
case cj_顶屏后连续输入_了珏
schema yoyo-pure-cj
step s      ""    "s"
step l      ""    "sl"
step space  "了"  ""
step ,      ""    ","
step ,      ""    ",,"
step O      "珏"  ""
